import java.io.*;
public class Main {
    public static void main(String[] args) {
        String[] files = {"store1.txt", "store2.txt", "store3.txt"};
        try {
            for (int i = 0; i < files.length; i++) {
                FileWriter fw = new FileWriter(files[i]);
                if (i == 0)
                    fw.write("1000\n");
                else if (i == 1)
                    fw.write("2000\n");
                else
                    fw.write("3000\n");
                fw.close();
            }
        } catch (IOException e) {
            System.out.println(e.getMessage());
            return;
        }
        BufferedWriter report = null;
        int total = 0;
        try {
            report = new BufferedWriter(
                new FileWriter("report.txt"));
            for (String file : files) {
                BufferedReader br = null;
                try {
                    br = new BufferedReader(
                        new FileReader(file));
                    String line;
                    while ((line = br.readLine()) != null) {
                        total += Integer.parseInt(line);
                    }
                    System.out.println("Read: " + file);
                } finally {
                    if (br != null) {
                        br.close();
                    }
                }
            }
            report.write("Total Sales: " + total);
            report.newLine();
            System.out.println("Report generated successfully.");
        } catch (IOException | NumberFormatException e) {
            System.out.println("Error: " + e.getMessage());
        } finally {
            try {
                if (report != null)
                    report.close();
            } catch (IOException e) {
                System.out.println("Report closing error: " + e.getMessage());
            }
        }
    }
}
