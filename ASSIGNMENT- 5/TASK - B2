public class Main {
    static String dbUser = "admin";
    static String dbPassword = "secret123";
    static boolean unsafeLogin(String user, String pass) {
        if (user.equals(dbUser) &&
            pass.contains("' OR '1'='1'")) {
            return true;
        }
        return user.equals(dbUser) &&
               pass.equals(dbPassword);
    }
    static boolean safeLogin(String user, String pass) {
        return user.equals(dbUser) &&
               pass.equals(dbPassword);
    }
    static void checkFile() {
        String[] records = {
            "P101,REG101,Arun,12,500",
            "P102,REG102",
            "P103,REG103,Kumar,12,ABC",
            "",
            "P104,REG104,Divya,15,700"
        };
        System.out.println("\nBUS-PASS FILE CHECK:");
        for (int i = 0; i < records.length; i++) {
            String line = records[i];
            if (line.trim().isEmpty()) {
                System.out.println(
                    "Line " + (i + 1) + ": Empty line skipped");
                continue;
            }
            String[] fields = line.split(",", -1);
            if (fields.length != 5) {
                System.out.println(
                    "Line " + (i + 1) + ": Wrong number of fields");
                continue;
            }
            try {
                Double.parseDouble(fields[4]);
                System.out.println(
                    "Line " + (i + 1) + ": Valid record");
            } catch (NumberFormatException e) {
               System.out.println(
                    "Line " + (i + 1) + ": Invalid amount");
            }
        }
    }
    public static void main(String[] args) {
        String username = "admin";
        String attack = "' OR '1'='1' -- ";
        System.out.println("UNSAFE LOGIN:");
        if (unsafeLogin(username, attack))
            System.out.println("Login Accepted");
        else
            System.out.println("Login Rejected");
        System.out.println("\nPREPAREDSTATEMENT LOGIN:");
        if (safeLogin(username, attack))
            System.out.println("Login Accepted");
        else
            System.out.println("Login Rejected");
        checkFile();
    }
}
