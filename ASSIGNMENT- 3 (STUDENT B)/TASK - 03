import java.io.*;
public class Main {
    public static void main(String[] args) {
        String[] files = {"store1.txt", "store2.txt", "store3.txt"};
        try {
            for (int i = 0; i < files.length; i++) {
                try (BufferedWriter bw =
                     new BufferedWriter(new FileWriter(files[i]))) {
                    if (i == 0)
                        bw.write("1000");
                    else if (i == 1)
                        bw.write("2000");
                    else
                        bw.write("3000");
                }
            }
        } catch (IOException e) {
            System.out.println("File creation error: " + e.getMessage());
            return;
        }
        int total = 0;
        try (BufferedWriter report =
             new BufferedWriter(new FileWriter("report.txt"))) {
            for (String file : files) {
                System.out.println("Processing: " + file);
                try (BufferedReader br =
                     new BufferedReader(new FileReader(file))) {
                    String line;
                    while ((line = br.readLine()) != null) {
                        total += Integer.parseInt(line);
                    }
                }
                System.out.println("Closed: " + file);
            }
            report.write("Total Sales: " + total);
            report.newLine();
            System.out.println("Report generated successfully.");
            System.out.println("Total Sales: " + total);
        } catch (IOException | NumberFormatException e) {
            System.out.println("Report generation failed: " + e.getMessage());
        }
        System.out.println("All resources closed.");
    }
}
