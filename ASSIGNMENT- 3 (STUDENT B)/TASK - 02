import java.io.IOException;
class ExamException extends Exception {
    ExamException(String message) {
        super(message);
    }
    ExamException(String message, Throwable cause) {
        super(message, cause);
    }
}
class ExamClosedException extends ExamException {
    ExamClosedException(String message) {
        super(message);
    }
}
class StudentNotRegisteredException extends ExamException {
    StudentNotRegisteredException(String message) {
        super(message);
    }
}
class SubmissionStorageException extends ExamException {
    SubmissionStorageException(String message, Throwable cause) {
        super(message, cause);
    }
}
class Storage {
    void save(String fileName, long sizeKb)
            throws SubmissionStorageException {
        try {
            if (sizeKb > 500) {
                throw new IOException("Disk quota exceeded");
            }
            System.out.println("Saved " + fileName);

        } catch (IOException e) {
            throw new SubmissionStorageException(
                "Could not store " + fileName, e);
        }
    }
}
class ExamService {
    Storage storage = new Storage();
    void submit(String fileName, long sizeKb, boolean registered)
            throws ExamException {
        if (!registered) {
            throw new StudentNotRegisteredException(
                "Student is not registered for this course");
        }
        storage.save(fileName, sizeKb);
    }
}
class ExamController {
    ExamService service = new ExamService();
    void submitExam(String fileName, long sizeKb,
                    boolean registered, boolean examOpen)
            throws ExamException {
        if (!examOpen) {
            throw new ExamClosedException(
                "Exam submission window is closed");
        }
        service.submit(fileName, sizeKb, registered);
    }
}
public class Main {
    static void test(String file, long size,
                     boolean registered, boolean open) {

        ExamController controller = new ExamController();
        try {
            controller.submitExam(file, size, registered, open);
        } catch (ExamException e) {
            System.out.println("Error: " + e.getMessage());
            if (e.getCause() != null) {
                System.out.println("Cause: " +
                    e.getCause().getMessage());
                System.out.println("Full Chained Stack Trace:");
                e.printStackTrace(System.out);
            }
        }
        System.out.println("-------------------------");
    }
    public static void main(String[] args) {
     System.out.println("TEST 1: Exam Closed");
        test("answer01.pdf", 120, true, false);
       System.out.println("TEST 2: Student Not Registered");
        test("answer02.pdf", 120, false, true);
        System.out.println("TEST 3: File Size Exceeded");
        test("answer03.pdf", 800, true, true);
    }
}
