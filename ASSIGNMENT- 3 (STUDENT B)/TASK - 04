import java.util.*;
class ScannerStation extends Thread {
    int station;
    int scripts;
    static List<Integer> finishOrder =
        Collections.synchronizedList(new ArrayList<>());
    ScannerStation(int station, int scripts) {
        this.station = station;
        this.scripts = scripts;
    }
    public void run() {
        System.out.println("Station " + station + " started.");
        try {
            for (int i = 1; i <= scripts; i++) {
                Thread.sleep(200);
            }
        } catch (InterruptedException e) {
            System.out.println("Station interrupted.");
            Thread.currentThread().interrupt();
            return;
        }
        finishOrder.add(station);
        System.out.println("Station " + station + " completed.");
    }
}
public class Main {
    public static void main(String[] args) {
        ScannerStation s1 = new ScannerStation(1, 3);
        ScannerStation s2 = new ScannerStation(2, 3);
        ScannerStation s3 = new ScannerStation(3, 3);
        ScannerStation s4 = new ScannerStation(4, 3);
        s1.setPriority(Thread.MIN_PRIORITY);
        s2.setPriority(Thread.NORM_PRIORITY);
        s3.setPriority(Thread.MAX_PRIORITY);
        s4.setPriority(Thread.NORM_PRIORITY);

        s1.start();
        s2.start();
        s3.start();
        s4.start();
        try {
            s1.join();
            s2.join();
            s3.join();
            s4.join();
        } catch (InterruptedException e) {
            System.out.println("Main interrupted.");
            Thread.currentThread().interrupt();
            return;
        }
        System.out.println("Completion Order: " +
                           ScannerStation.finishOrder);

        System.out.println("All stations completed.");
    }
}
