import java.util.concurrent.CyclicBarrier;
class Account {
    int id;
    int balance;
    Account(int id, int balance) {
        this.id = id;
        this.balance = balance;
    }
}
public class Main {
    static void unsafeTransfer(
            Account from, Account to,
            CyclicBarrier barrier) {
        synchronized (from) {
            System.out.println(
                Thread.currentThread().getName()
                + " locked Account " + from.id);
            try {
                barrier.await();
            } catch (Exception e) {
                return;
            }
            synchronized (to) {
                from.balance -= 100;
                to.balance += 100;
            }
        }
    }
    static void safeTransfer(Account from, Account to) {
        Account first = from.id < to.id ? from : to;
        Account second = from.id < to.id ? to : from;
        synchronized (first) {
            synchronized (second) {
                from.balance -= 100;
                to.balance += 100;
                System.out.println(
                    Thread.currentThread().getName()
                    + " completed transfer");
            }
        }
    }
    public static void main(String[] args)
            throws InterruptedException {
        Account a = new Account(1, 1000);
        Account b = new Account(2, 1000);
        System.out.println("DEADLOCK DEMONSTRATION");
        CyclicBarrier barrier = new CyclicBarrier(2);
        Thread t1 = new Thread(
            () -> unsafeTransfer(a, b, barrier), "Thread-1");
        Thread t2 = new Thread(
            () -> unsafeTransfer(b, a, barrier), "Thread-2");
        t1.setDaemon(true);
        t2.setDaemon(true);
        t1.start();
        t2.start();
        Thread.sleep(500);
        System.out.println("Thread-1 state: " + t1.getState());
        System.out.println("Thread-2 state: " + t2.getState());
        System.out.println("\nDEADLOCK PREVENTION");
        Account x = new Account(1, 1000);
        Account y = new Account(2, 1000);
        Thread t3 = new Thread(
            () -> safeTransfer(x, y), "Thread-3");
        Thread t4 = new Thread(
            () -> safeTransfer(y, x), "Thread-4");
        t3.start();
        t4.start();
        t3.join();
        t4.join();
        System.out.println("Final Account 1 Balance: " + x.balance);
        System.out.println("Final Account 2 Balance: " + y.balance);
    }
}
