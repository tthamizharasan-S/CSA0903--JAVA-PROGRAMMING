interface Chargeable {
    void chargeBattery();
    default void showChargingStatus() {
        System.out.println("Charging capability available");
    }
    static void chargingInfo() {
        System.out.println("Electric vehicles require charging");
    }
}
abstract class Vehicle {
    protected String regNo;
    protected String owner;
    Vehicle(String regNo, String owner) {
        this.regNo = regNo;
        this.owner = owner;
    }
    abstract double calculateFee(int hours);
    void display() {
        System.out.println("Registration: " + regNo);
        System.out.println("Owner: " + owner);
    }
}
class Car extends Vehicle {
    Car(String regNo, String owner) {
        super(regNo, owner);
    }
    @Override
    double calculateFee(int hours) {
        return hours * 40;
    }
}
class Bike extends Vehicle {
    Bike(String regNo, String owner) {
        super(regNo, owner);
    }
    @Override
    double calculateFee(int hours) {
        return hours * 10;
    }
}
class ElectricCar extends Vehicle implements Chargeable {
    ElectricCar(String regNo, String owner) {
        super(regNo, owner);
    }
    @Override
    double calculateFee(int hours) {
        return hours * 30;
    }
    @Override
    public void chargeBattery() {
        System.out.println("Electric car battery is charging");
    }
}
public class Main {
    public static void main(String[] args) {
        Vehicle v1 = new Car("TN01AB1234", "Arun");
        Vehicle v2 = new Bike("TN02CD5678", "Kumar");
        ElectricCar ev = new ElectricCar("TN03EF9012", "Ravi");
        v1.display();
        System.out.println("Car Fee: Rs." + v1.calculateFee(2));
        v2.display();
        System.out.println("Bike Fee: Rs." + v2.calculateFee(2));
        ev.display();
        System.out.println("Electric Car Fee: Rs." + ev.calculateFee(2));
        ev.chargeBattery();
        ev.showChargingStatus();
        Chargeable.chargingInfo();
    }
}
