import java.util.Scanner;
class Vehicle {
    String regNo;
    String type;
    Vehicle(String regNo, String type) {
        this.regNo = regNo;
        this.type = type;
    }
}
class ParkingTicket {
    int ticketNo;
    Vehicle vehicle;
    int slotNo;
    ParkingTicket(int ticketNo, Vehicle vehicle, int slotNo) {
        this.ticketNo = ticketNo;
        this.vehicle = vehicle;
        this.slotNo = slotNo;
    }
    void displayTicket() {
        System.out.println("\n----- PARKING TICKET -----");
        System.out.println("Ticket Number: " + ticketNo);
        System.out.println("Vehicle Number: " + vehicle.regNo);
        System.out.println("Vehicle Type: " + vehicle.type);
        System.out.println("Slot Number: " + slotNo);
    }
}
class ParkingSlot {
    int slotNo;
    Vehicle vehicle;
    ParkingTicket ticket;
    ParkingSlot(int slotNo) {
        this.slotNo = slotNo;
        this.vehicle = null;
        this.ticket = null;
    }
    boolean isAvailable() {
        return vehicle == null;
    }
}
class ParkingLot {
    ParkingSlot[] slots;
    int ticketCounter = 1000;
    ParkingLot(int capacity) {
        slots = new ParkingSlot[capacity];
        for (int i = 0; i < capacity; i++) {
            slots[i] = new ParkingSlot(i + 1);
        }
    }
    void parkVehicle(String regNo, String type) {
        if (findVehicle(regNo) != null) {
            System.out.println("Vehicle is already parked!");
            return;
        }
        for (ParkingSlot slot : slots) {
            if (slot.isAvailable()) {
                Vehicle v = new Vehicle(regNo, type);
                ParkingTicket t =
                    new ParkingTicket(++ticketCounter, v, slot.slotNo);
                slot.vehicle = v;
                slot.ticket = t;
                System.out.println("Vehicle parked successfully!");
                t.displayTicket();
                return;
            }
        }
        System.out.println("Parking lot is full!");
    }    Vehicle findVehicle(String regNo) {
        for (ParkingSlot slot : slots) {
            if (slot.vehicle != null &&
                slot.vehicle.regNo.equalsIgnoreCase(regNo)) {
                return slot.vehicle;
            }
        }
        return null;
    }
    void removeVehicle(String regNo) {
        for (ParkingSlot slot : slots) {
            if (slot.vehicle != null &&
                slot.vehicle.regNo.equalsIgnoreCase(regNo)) {
                System.out.println("Vehicle removed successfully!");
                System.out.println("Ticket Number: " +
                                   slot.ticket.ticketNo);
                System.out.println("Slot Number: " + slot.slotNo);
                slot.vehicle = null;
                slot.ticket = null;
                return;
            }
        }
        System.out.println("Vehicle not found!");
    }
    void displayStatus() {
        System.out.println("\n----- PARKING STATUS -----");
        for (ParkingSlot slot : slots) {
            if (slot.isAvailable()) {
                System.out.println("Slot " + slot.slotNo +
                                   " : Available");
            } else {
                System.out.println("Slot " + slot.slotNo +
                    " : Occupied by " + slot.vehicle.regNo);
            }
        }
    }
}
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ParkingLot parking = new ParkingLot(5);
        int choice;
        do {
            System.out.println("\n===== PARKING MANAGEMENT SYSTEM =====");
            System.out.println("1. Park Vehicle");
            System.out.println("2. Search Vehicle");
            System.out.println("3. Remove Vehicle");
            System.out.println("4. Display Parking Status");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");
            choice = sc.nextInt();
            sc.nextLine();
            switch (choice) {
                case 1:
                    System.out.print("Enter Registration Number: ");
                    String regNo = sc.nextLine();

                    System.out.print("Enter Vehicle Type: ");
                    String type = sc.nextLine();
                    parking.parkVehicle(regNo, type);
                    break;
                case 2:
                    System.out.print("Enter Registration Number: ");
                    String searchNo = sc.nextLine();
                    Vehicle v = parking.findVehicle(searchNo);
                    if (v != null) {
                        System.out.println("Vehicle Found!");
                        System.out.println("Registration: " + v.regNo);
                        System.out.println("Type: " + v.type);
                    } else {
                        System.out.println("Vehicle Not Found!");
                    }
                    break;
                case 3:
                    System.out.print("Enter Registration Number: ");
                    String removeNo = sc.nextLine();
                    parking.removeVehicle(removeNo);
                    break;
                case 4:
                    parking.displayStatus();
                    break;
                case 5:
                    System.out.println("Thank you!");
                    break;
                default:
                    System.out.println("Invalid Choice!");
            }
        } while (choice != 5);
        sc.close();
    }
}
